{
  "name": "grow",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=25.0.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "smoke": "playwright test",
    "unit:anchor-phrase": "playwright test tests/anchor-phrase.unit.spec.ts --config=playwright.unit.config.ts",
    "unit:anchor-phrase-edit": "playwright test tests/anchor-phrase-edit.unit.spec.ts --config=playwright.unit.config.ts",
    "unit:anchor-phrase-render": "playwright test tests/anchor-phrase-render.unit.spec.ts --config=playwright.unit.config.ts",
    "unit:grow-language": "playwright test tests/grow-language.unit.spec.ts --config=playwright.unit.config.ts",
    "unit:song-goal": "playwright test tests/song-goal.unit.spec.ts --config=playwright.unit.config.ts",
    "unit:melody-plan": "playwright test tests/melody-plan.unit.spec.ts --config=playwright.unit.config.ts",
    "unit:melody-prosody": "playwright test tests/melody-prosody.unit.spec.ts --config=playwright.unit.config.ts",
    "unit:motif-memory": "playwright test tests/motif-memory.unit.spec.ts --config=playwright.unit.config.ts",
    "unit:harmonic-color": "playwright test tests/harmonic-color.unit.spec.ts --config=playwright.unit.config.ts",
    "unit:song-starter-material": "playwright test tests/song-starter-material.unit.spec.ts --config=playwright.unit.config.ts",
    "unit:phrase-candidate-genome": "playwright test tests/phrase-candidate-genome.unit.spec.ts --config=playwright.unit.config.ts",
    "db:init": "node scripts/grow-db.mjs init",
    "db:dump": "node scripts/grow-db.mjs dump",
    "db:smoke": "node scripts/grow-db.mjs smoke"
  },
  "dependencies": {
    "pixi.js": "8.18.1",
    "tone": "15.1.22"
  },
  "devDependencies": {
    "@playwright/test": "1.60.0",
    "typescript": "5.9.2",
    "vite": "7.3.3"
  }
}
