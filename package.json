    "db:dump": "node scripts/grow-db.mjs dump",
    "db:smoke": "node scripts/grow-db.mjs smoke"
  },
  "dependencies": {
    "pixi.js": "8.18.1",
    "tone": "15.1.22"
  },
  "devDependencies": {
    "@playwright/test": "1.60.0",
    "typescript": "5.9.2",
    "vite": "7.3.3"
  }
}
