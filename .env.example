# Copy to .env.local when GitHub credentials are needed.
# Keep real secrets out of git.

GITHUB_OWNER=arnegleason
GITHUB_REPO=grow

# Local development only, if a temporary token is needed.
GITHUB_TOKEN=

# GitHub App integration, if selected.
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
GITHUB_PRIVATE_KEY_PATH=
GITHUB_WEBHOOK_SECRET=

# OAuth integration, if selected.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
