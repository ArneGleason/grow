# Copy to .env.local when GitHub credentials are needed.
# Keep real secrets out of git.

GITHUB_OWNER=arnegleason
GITHUB_REPO=grow

# Local development only, if a temporary token is needed.
GITHUB_TOKEN=

# Browser-visible local Ollama settings for Grow's manual thought probe.
# Keep these non-secret. Adjust the model tag to whatever `ollama list` shows locally.
VITE_GROW_OLLAMA_BASE_URL=http://127.0.0.1:11434
VITE_GROW_OLLAMA_MODEL=qwen3:4b-instruct-2507-q4_K_M

# GitHub App integration, if selected.
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
GITHUB_PRIVATE_KEY_PATH=
GITHUB_WEBHOOK_SECRET=

# OAuth integration, if selected.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
